{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Basalt chart",
  "description": "A Basalt chart, format 3. See docs/chart-format.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 1
    },
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "examples": [
        "Easy",
        "Normal",
        "Hard",
        "Expert"
      ]
    },
    "description": {
      "type": "string"
    },
    "arena": {
      "type": "object",
      "properties": {
        "map": {
          "enum": [
            "gym",
            "ring",
            "pit"
          ],
          "default": "ring"
        },
        "at": {
          "type": "object",
          "description": "Where you stand: metres from the map's centre (the Gym: world). Default 0, 0. Lane setup in game writes yours.",
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "facing": {
              "type": "number",
              "description": "Compass degrees the lane runs from you: 0 = +Z, 90 = +X. Default 0."
            }
          },
          "required": [
            "x",
            "z"
          ]
        }
      },
      "description": "Where it is played. Without one: the Ring, at { x: 0, z: -6 } facing north."
    },
    "music": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*\\.\\.)(?!.*:).+\\.(ogg|mp3)$"
        },
        "offset": {
          "type": "number",
          "default": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "required": [
        "file"
      ]
    },
    "cover": {
      "type": "string",
      "description": "A PNG or JPG beside the chart, shown on the menu.",
      "pattern": "^(?![/\\\\])(?!.*\\.\\.)(?!.*:).+\\.(png|jpg|jpeg)$"
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bpmChanges": {
      "description": "Tempo changes after the start, each holding until the next.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "bpm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "beat",
          "bpm"
        ]
      }
    },
    "lane": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 2,
          "default": 12
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "at": {
            "$ref": "#/$defs/spot"
          },
          "shiftstones": {
            "description": "The stones it wears, up to two names. Without it: none.",
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "examples": [
                "Adamant",
                "Charge",
                "Flow",
                "Guard",
                "Stubborn",
                "Surge",
                "Vigor",
                "Volatile"
              ]
            }
          },
          "look": {
            "type": "string",
            "examples": [
              "you",
              "default",
              "defaultMale",
              "defaultFemale"
            ]
          },
          "measurement": {
            "description": "The body's size in metres; keeping a clip stores the recorder's.",
            "type": "object",
            "required": [
              "height",
              "armSpan"
            ],
            "properties": {
              "height": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 3
              },
              "armSpan": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "t": {
            "type": "number",
            "minimum": 0
          },
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "colours": {
            "type": "object",
            "description": "The lane's colours from this phase on, over the chart's.",
            "properties": {
              "sideLines": {
                "$ref": "#/$defs/colour"
              },
              "endLines": {
                "$ref": "#/$defs/colour"
              },
              "zoneLine": {
                "$ref": "#/$defs/colour"
              },
              "backstop": {
                "$ref": "#/$defs/colour"
              },
              "walls": {
                "$ref": "#/$defs/colour"
              }
            }
          },
          "scoreMultiplier": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "actor": {
            "type": "string"
          },
          "projectile": {
            "type": "object",
            "properties": {
              "structure": {
                "enum": [
                  "Disc",
                  "Ball",
                  "Pillar",
                  "Wall",
                  "RockCube",
                  "BoulderBall",
                  "SmallRock",
                  "LargeRock"
                ]
              },
              "from": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "z": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "to": {
                "description": "Where it arrives on your end of the lane. Without it: at you.",
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "telegraph": {
                "type": "number",
                "minimum": 0,
                "default": 0.5
              },
              "grounded": {
                "type": "boolean",
                "description": "Thrown along the floor in the game's grounded state. Default true for Pillar, RockCube and Wall."
              }
            },
            "required": [
              "structure",
              "from",
              "speed"
            ]
          },
          "move": {
            "type": "string",
            "examples": [
              "Straight",
              "Uppercut",
              "Kick",
              "Stomp",
              "Explode",
              "Flick",
              "Parry",
              "Jump",
              "RockSlide",
              "Disc",
              "SpawnBall",
              "SpawnCube",
              "SpawnPillar",
              "SpawnWall",
              "HoldLeft",
              "HoldRight"
            ]
          },
          "at": {
            "$ref": "#/$defs/spot"
          }
        },
        "oneOf": [
          {
            "required": [
              "projectile"
            ]
          },
          {
            "required": [
              "move"
            ]
          },
          {
            "required": [
              "at"
            ]
          }
        ]
      }
    },
    "end": {
      "type": "number",
      "minimum": 0
    },
    "performances": {
      "type": "array",
      "description": "Recorded performances, written by RECORD / KEEP. Needs format 2.",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string"
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "beat": {
                  "type": "number",
                  "minimum": 0
                },
                "clip": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number"
                },
                "mime": {
                  "type": "boolean"
                }
              },
              "required": [
                "clip"
              ]
            }
          }
        }
      }
    },
    "playerZone": {
      "type": "object",
      "description": "Where you may go: length along the lane from your end, height above the floor.",
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "default": 3.5
        }
      }
    },
    "colours": {
      "type": "object",
      "description": "The lane's colours, as #RRGGBB or #RRGGBBAA.",
      "properties": {
        "sideLines": {
          "$ref": "#/$defs/colour"
        },
        "endLines": {
          "$ref": "#/$defs/colour"
        },
        "zoneLine": {
          "$ref": "#/$defs/colour"
        },
        "backstop": {
          "$ref": "#/$defs/colour"
        },
        "walls": {
          "$ref": "#/$defs/colour",
          "description": "Shows the invisible walls as see-through panes; give an opacity, e.g. #66ccff33."
        }
      }
    },
    "shaders": {
      "type": "array",
      "description": "Shader looks over time, for players with RumbleReShaded.",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "pack": {
            "type": "string",
            "description": "An installed RumbleReShaded pack's name, e.g. UltraShade."
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Slider values by label or property."
          },
          "off": {
            "type": "boolean"
          },
          "fade": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "pack"
        ]
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "breakBehind": {
          "type": "boolean",
          "default": false,
          "description": "Breaks, without a sound, any structure wholly past your end of the lane, so they do not pile up behind you."
        },
        "breakStillAfter": {
          "type": "number",
          "minimum": 0,
          "default": 3,
          "description": "Seconds a structure may sit still in a battle before it breaks; 0 never."
        },
        "playerSpawns": {
          "enum": [
            "all",
            "discs",
            "none"
          ],
          "default": "all"
        }
      }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^(#?([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|none)$"
    },
    "spot": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number",
          "minimum": 0
        },
        "facing": {
          "type": "number",
          "default": 0
        }
      },
      "required": [
        "x",
        "z"
      ]
    }
  }
}
