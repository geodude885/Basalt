<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Version.props" />

	<PropertyGroup>
		<!-- net6.0 is required: MelonLoader hosts a .NET 6 runtime inside the IL2CPP game process. -->
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<NoWarn>NU1603,NU1701,MSB3270</NoWarn>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" />
		<PackageReference Include="Lib.Harmony" Version="2.4.2" />
		<PackageReference Include="NLayer" Version="1.16.0" GeneratePathProperty="true" />
		<PackageReference Include="NVorbis" Version="0.10.5" GeneratePathProperty="true" />
	</ItemGroup>

	<!-- Game assemblies. Paths come from Directory.Build.props ($(Il2CppPath) / $(ModsOutputPath)).
	     Trim references you don't use; add more from the Il2CppAssemblies folder as needed. -->
	<ItemGroup>
		<Reference Include="Il2CppBucketheadEntertainment.Plugins">
			<HintPath>$(Il2CppPath)\Il2CppBucketheadEntertainment.Plugins.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(Il2CppPath)\Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppPhoton3Unity3D">
			<HintPath>$(Il2CppPath)\Il2CppPhoton3Unity3D.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppPhotonRealtime">
			<HintPath>$(Il2CppPath)\Il2CppPhotonRealtime.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppPhotonUnityNetworking">
			<HintPath>$(Il2CppPath)\Il2CppPhotonUnityNetworking.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppRUMBLE.Runtime">
			<HintPath>$(Il2CppPath)\Il2CppRUMBLE.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(Il2CppPath)\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(Il2CppPath)\UnityEngine.PhysicsModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.VRModule">
			<HintPath>$(Il2CppPath)\UnityEngine.VRModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.AudioModule">
			<HintPath>$(Il2CppPath)\UnityEngine.AudioModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(Il2CppPath)\UnityEngine.AnimationModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(Il2CppPath)\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(Il2CppPath)\Unity.InputSystem.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(Il2CppPath)\UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(Il2CppPath)\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(Il2CppPath)\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<!-- Optional at runtime: only touched from isolated NoInlining methods, so the mod still loads without it. -->
		<Reference Include="UIFramework">
			<HintPath>$(ModsOutputPath)\UIFramework.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- The chart editor, opened from the game: built from editor/index.html by tools/build-editor.py. -->
	<ItemGroup>
		<EmbeddedResource Include="Editor\BossBattlesEditor.html" LogicalName="BossBattles.ChartEditor.html" />
	</ItemGroup>

	<!-- Copy the built mod straight into RUMBLE\Mods. Warns (instead of failing) if the game is running. -->
	<!-- The song decoders (MIT): MelonLoader loads libraries from RUMBLE\UserLibs. -->
	<Target Name="CopyDecodersToUserLibs" AfterTargets="Build">
		<ItemGroup>
			<Decoder Include="$(PkgNLayer)\lib\netstandard2.0\NLayer.dll;$(PkgNVorbis)\lib\netstandard2.0\NVorbis.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(Decoder)" DestinationFolder="$(RumblePath)\UserLibs" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>

	<Target Name="CopyToMods" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsOutputPath)" SkipUnchangedFiles="false" Retries="2" RetryDelayMilliseconds="500" ContinueOnError="true">
			<Output TaskParameter="CopiedFiles" ItemName="_Copied" />
		</Copy>
		<Message Importance="high" Text="Copied $(TargetName).dll to RUMBLE\Mods." />
	</Target>

</Project>
